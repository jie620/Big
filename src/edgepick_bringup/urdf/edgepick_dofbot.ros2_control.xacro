<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="edgepick_dofbot_ros2_control" params="name initial_positions_file use_real_i2c:=false i2c_device:=/dev/i2c-7 i2c_address:=0x15">
    <xacro:property name="initial_positions" value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>

    <ros2_control name="${name}" type="system">
      <hardware>
        <!-- Stage 3 uses EdgePick's own mock system. It never opens I2C. -->
        <plugin>edgepick_hardware/MockSystemInterface</plugin>
        <param name="use_real_i2c">${use_real_i2c}</param>
        <param name="i2c_device">${i2c_device}</param>
        <param name="i2c_address">${i2c_address}</param>
      </hardware>

      <joint name="Arm1_Joint">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['Arm1_Joint']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>

      <joint name="Arm2_Joint">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['Arm2_Joint']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>

      <joint name="Arm3_Joint">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['Arm3_Joint']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>

      <joint name="Arm4_Joint">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['Arm4_Joint']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>

      <joint name="Arm5_Joint">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['Arm5_Joint']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>

      <joint name="grip_joint">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['grip_joint']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>
  </xacro:macro>
</robot>
