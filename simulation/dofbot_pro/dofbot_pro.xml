                  <geom type="mesh" rgba="1 1 1 0" mesh="llink1" group="3" />
                  <body name="llink2" pos="0.027362 0.012302 -0.0025" quat="0.836901 0 0 -0.547355">
                    <inertial pos="0.0226936 -0.00567118 -0.0015" quat="0.0506787 0.705288 -0.0506787 0.705288" mass="0.00614487" diaginertia="1.57602e-06 1.5385e-06 4.67285e-08" />
                    <joint name="llink_joint2" range="0 1.6" axis="0 0 1" />
                    <geom type="mesh" rgba="1 1 1 1" mesh="llink2" contype="1" conaffinity="0" density="0" group="1" class="visualgeom" />
                    <geom type="mesh" rgba="1 1 1 0" mesh="llink2" group="3" />
                  </body>
                </body>
                <body name="rlink3" pos="0.0045 0.047275 0.0045" quat="0.977611 0 0 0.21042">
                  <inertial pos="0.0134815 -0.0060854 -0.0027141" quat="0.594015 0.594015 0.383596 0.383596" mass="0.00270972" diaginertia="1.63608e-07 1.63255e-07 9.18475e-09" />
                  <joint name="rlink_joint3" range="0 1.6" axis="0 0 1" />
                  <geom type="mesh" rgba="1 1 1 1" mesh="rlink3" contype="1" conaffinity="0" density="0" group="1" class="visualgeom" />
                  <geom type="mesh" rgba="1 1 1 0" mesh="rlink3" group="3" />
                </body>
                <body name="llink3" pos="-0.0045 0.047275 0.0045" quat="0.204738 0 0 0.978817">
                  <inertial pos="0.0135673 0.00589169 -0.0027141" quat="0.38784 0.38784 0.591253 0.591253" mass="0.00270972" diaginertia="1.63608e-07 1.63255e-07 9.18475e-09" />
                  <joint name="llink_joint3" range="-1.6 0" axis="0 0 1" />
                  <geom type="mesh" rgba="1 1 1 1" mesh="llink3" contype="1" conaffinity="0" density="0" group="1" class="visualgeom" />
                  <geom type="mesh" rgba="1 1 1 0" mesh="llink3" group="3" />
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <equality>
    <joint name="rlink_joint2_mimic" joint1="rlink_joint2" joint2="grip_joint" polycoef="0 1 0 0 0" />
    <joint name="llink_joint1_mimic" joint1="llink_joint1" joint2="grip_joint" polycoef="0 1 0 0 0" />
    <joint name="llink_joint2_mimic" joint1="llink_joint2" joint2="grip_joint" polycoef="0 -1 0 0 0" />
    <joint name="rlink_joint3_mimic" joint1="rlink_joint3" joint2="grip_joint" polycoef="0 -1 0 0 0" />
    <joint name="llink_joint3_mimic" joint1="llink_joint3" joint2="grip_joint" polycoef="0 1 0 0 0" />
  </equality>

  <!-- Control tuning: kp/kv set response speed/damping; forcerange limits torque. -->
  <actuator>
    <position name="Arm1_Joint" joint="Arm1_Joint" kp="8" kv="0.8" ctrlrange="-1.5708 1.5708" ctrllimited="true" forcelimited="true" forcerange="-5 5" />
    <position name="Arm2_Joint" joint="Arm2_Joint" kp="8" kv="0.8" ctrlrange="-1.5708 1.5708" ctrllimited="true" forcelimited="true" forcerange="-5 5" />
    <position name="Arm3_Joint" joint="Arm3_Joint" kp="8" kv="0.8" ctrlrange="-1.5708 1.5708" ctrllimited="true" forcelimited="true" forcerange="-5 5" />
    <position name="Arm4_Joint" joint="Arm4_Joint" kp="8" kv="0.8" ctrlrange="-1.5708 1.5708" ctrllimited="true" forcelimited="true" forcerange="-5 5" />
    <position name="Arm5_Joint" joint="Arm5_Joint" kp="8" kv="0.8" ctrlrange="-1.5708 3.1416" ctrllimited="true" forcelimited="true" forcerange="-5 5" />
    <position name="grip_joint" joint="grip_joint" kp="8" kv="0.8" ctrlrange="-1.6 0" ctrllimited="true" forcelimited="true" forcerange="-5 5" />
  </actuator>

  <sensor>
    <actuatorpos name="Arm1_Joint_p" actuator="Arm1_Joint" />
    <actuatorvel name="Arm1_Joint_v" actuator="Arm1_Joint" />
    <actuatorfrc name="Arm1_Joint_f" actuator="Arm1_Joint" noise="0.001" />
    <actuatorpos name="Arm2_Joint_p" actuator="Arm2_Joint" />
    <actuatorvel name="Arm2_Joint_v" actuator="Arm2_Joint" />
    <actuatorfrc name="Arm2_Joint_f" actuator="Arm2_Joint" noise="0.001" />
    <actuatorpos name="Arm3_Joint_p" actuator="Arm3_Joint" />
    <actuatorvel name="Arm3_Joint_v" actuator="Arm3_Joint" />
    <actuatorfrc name="Arm3_Joint_f" actuator="Arm3_Joint" noise="0.001" />
    <actuatorpos name="Arm4_Joint_p" actuator="Arm4_Joint" />
    <actuatorvel name="Arm4_Joint_v" actuator="Arm4_Joint" />
    <actuatorfrc name="Arm4_Joint_f" actuator="Arm4_Joint" noise="0.001" />
    <actuatorpos name="Arm5_Joint_p" actuator="Arm5_Joint" />
    <actuatorvel name="Arm5_Joint_v" actuator="Arm5_Joint" />
    <actuatorfrc name="Arm5_Joint_f" actuator="Arm5_Joint" noise="0.001" />
    <actuatorpos name="grip_joint_p" actuator="grip_joint" />
    <actuatorvel name="grip_joint_v" actuator="grip_joint" />
    <actuatorfrc name="grip_joint_f" actuator="grip_joint" noise="0.001" />
    <framequat name="orientation" objtype="site" noise="0.001" objname="imu" />
    <gyro name="angular-velocity" site="imu" noise="0.005" cutoff="34.9" />
  </sensor>
</mujoco>
