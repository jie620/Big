          <body name="Arm3_Link" pos="-0.00055 0 0.08285">
            <inertial pos="0.000230967 -0.00348204 0.0312592" quat="0.707645 0.00438014 0.00593195 0.70653" mass="0.0484404" diaginertia="1.7508e-05 1.38992e-05 7.82716e-06" />
            <joint name="Arm3_Joint" range="-1.5708 1.5708" actuatorfrcrange="-100 100" axis="1 0 0" />
