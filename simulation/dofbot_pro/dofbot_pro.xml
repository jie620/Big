            <body name="Arm4_Link" pos="-5e-05 0 0.08285" quat="0.707107 0.707107 0 0">
              <inertial pos="-0.000333227 0.0435755 0.0178058" quat="0.653706 -0.239136 0.226861 0.681188" mass="0.0807892" diaginertia="8.62083e-05 7.60956e-05 2.78774e-05" />
              <joint name="Arm4_Joint" range="-1.5708 1.5708" actuatorfrcrange="-100 100" axis="1 0 0" />
              <geom type="mesh" rgba="1 1 1 1" mesh="Arm4_Link" contype="1" conaffinity="0" density="0" group="1" class="visualgeom" />
              <geom type="mesh" rgba="1 1 1 0" mesh="Arm4_Link" group="3" />
              <geom pos="-0.0002 0.0689 0.0506" quat="0.99999 0.00436331 0 0" type="mesh" rgba="0.25098 0.25098 0.25098 1" mesh="DaBai_DCW2_Link" contype="1" conaffinity="0" density="0" group="1" class="visualgeom" />
              <geom type="mesh" rgba="0.25098 0.25098 0.25098 0" mesh="DaBai_DCW2_Link" pos="-0.0002 0.0689 0.0506" quat="0.99999 0.00436331 0 0" group="3" />
