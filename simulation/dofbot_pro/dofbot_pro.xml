                <joint name="Arm5_Joint" range="-1.5708 3.1416" actuatorfrcrange="-100 100" axis="0 1 0" />
                <!-- Wrist camera: move it behind the gripper to reduce pre-grasp self-occlusion. -->
                <camera name="yolo" pos="0 0.03 0.05" xyaxes="1 0 0 0 0 1" fovy="60" />
                <site name="grasp_point" pos="0 0.08 0" size="0.008" rgba="0.1 1 0.1 1" />
                <geom type="mesh" rgba="0.25098 0.25098 0.25098 1" mesh="Arm5_Link" contype="1" conaffinity="0" density="0" group="1" class="visualgeom" />
                <geom type="mesh" rgba="0.25098 0.25098 0.25098 0" mesh="Arm5_Link" group="3" />
                <geom pos="0 0.09 0" quat="1 0 0 0" type="mesh" rgba="1 1 1 1" mesh="Gripping_point_Link" contype="1" conaffinity="0" density="0" group="1" class="visualgeom" />
                <geom type="mesh" rgba="1 1 1 0" mesh="Gripping_point_Link" pos="0 0.09 0" quat="1 0 0 0" group="3" />
                <body name="rlink1" pos="0.012625 0.029275 0.00475" quat="0.977611 0 0 0.21042">
                  <inertial pos="0.00749117 -0.00307322 -0.000464636" quat="0.166899 0.687128 -0.166899 0.687128" mass="0.00469662" diaginertia="5.45545e-07 4.53632e-07 1.01494e-07" />
                  <joint name="grip_joint" range="-1.6 0" actuatorfrcrange="-100 100" axis="0 0 -1" />
                  <geom type="mesh" rgba="1 1 1 1" mesh="rlink1" contype="1" conaffinity="0" density="0" group="1" class="visualgeom" />
                  <geom type="mesh" rgba="1 1 1 0" mesh="rlink1" group="3" />
                  <body name="rlink2" pos="0.027229 -0.012593 -0.0025" quat="0.840061 0 0 0.542491">
                    <inertial pos="0.0226141 0.00598033 -0.0015" quat="-0.0554899 0.704926 0.0554899 0.704926" mass="0.00614487" diaginertia="1.57602e-06 1.5385e-06 4.67285e-08" />
                    <joint name="rlink_joint2" range="-1.6 0" axis="0 0 1" />
                    <geom type="mesh" rgba="1 1 1 1" mesh="rlink2" contype="1" conaffinity="0" density="0" group="1" class="visualgeom" />
                    <geom type="mesh" rgba="1 1 1 0" mesh="rlink2" group="3" />
                  </body>
                </body>
                <body name="llink1" pos="-0.012375 0.029275 0.0045" quat="0.204738 0 0 0.978817">
                  <inertial pos="0.00820826 0.00331563 -0.000169456" quat="-0.160561 0.688636 0.160561 0.688636" mass="0.00426701" diaginertia="5.36666e-07 4.55979e-07 8.79672e-08" />
