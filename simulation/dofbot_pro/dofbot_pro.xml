<mujoco model="DOFBOT_Pro-V24">
  <option iterations="50" timestep="0.001" solver="PGS" gravity="0 0 -9.81" />

  <!-- Keep close-range wrist-camera geometry visible; extent=20 makes the default near plane 0.2 m. -->
  <visual>
    <map znear="0.0005" zfar="50" />
  </visual>

  <compiler angle="radian" meshdir="meshes" eulerseq="zyx" autolimits="true" />

  <default>
    <joint limited="true" damping="0.01" armature="0.01" frictionloss="0.01" />
    <geom condim="4" contype="1" conaffinity="0" friction="0.9 0.2 0.2" solref="0.001 2" />
    <motor ctrllimited="true" />
    <equality solref="0.001 2" />
    <default class="visualgeom">
      <geom material="visualgeom" condim="1" contype="0" conaffinity="0" />
    </default>
  </default>

  <asset>
    <mesh name="base_link" content_type="model/stl" file="base_link.STL" />
    <mesh name="Arm1_Link" content_type="model/stl" file="Arm1_Link.STL" />
    <mesh name="Arm2_Link" content_type="model/stl" file="Arm2_Link.STL" />
    <mesh name="Arm3_Link" content_type="model/stl" file="Arm3_Link.STL" />
    <mesh name="Arm4_Link" content_type="model/stl" file="Arm4_Link.STL" />
    <mesh name="DaBai_DCW2_Link" content_type="model/stl" file="DaBai_DCW2_Link.STL" />
    <mesh name="Arm5_Link" content_type="model/stl" file="Arm5_Link.STL" />
    <mesh name="rlink1" content_type="model/stl" file="rlink1.STL" />
    <mesh name="rlink2" content_type="model/stl" file="rlink2.STL" />
    <mesh name="llink1" content_type="model/stl" file="llink1.STL" />
    <mesh name="llink2" content_type="model/stl" file="llink2.STL" />
    <mesh name="rlink3" content_type="model/stl" file="rlink3.STL" />
    <mesh name="llink3" content_type="model/stl" file="llink3.STL" />
    <mesh name="Gripping_point_Link" content_type="model/stl" file="Gripping_point_Link.STL" />
    <texture name="checker" type="2d" builtin="checker" width="512" height="512" rgb1="0.03 0.08 0.18" rgb2="0.28 0.48 0.78" />
    <material name="grid" texture="checker" texrepeat="1 1" texuniform="true" reflectance="0.2" />
    <material name="visualgeom" rgba="0.5 0.9 0.2 1" />
    <material name="orange" rgba="1.0 0.62 0.03 1" />
  </asset>

  <worldbody>
    <light directional="true" diffuse="0.4 0.4 0.4" specular="0.1 0.1 0.1" pos="0 0 5.0" dir="0 0 -1" castshadow="false" />
    <light directional="true" diffuse="0.6 0.6 0.6" specular="0.2 0.2 0.2" pos="0 0 4" dir="0 0 -1" />
    <geom name="ground" type="plane" pos="0 0 -0.005" size="100 100 0.001" quat="1 0 0 0" material="grid" condim="3" conaffinity="15" />
    <!-- 6 cm diameter x 6 cm height orange, 10 cm in front of base (-Y). -->
    <body name="orange" pos="0 0.3 0.025">
      <freejoint name="orange_free" />
      <geom name="orange_geom" type="sphere" size="0.03" material="orange" density="500" friction="0.8 0.1 0.1" />
    </body>
    <body name="route_obstacle" pos="0.12 0.12 0.065">
      <geom name="route_obstacle_geom" type="box" size="0.025 0.025 0.07" rgba="0.8 0.15 0.15 1" contype="1" conaffinity="1"/>
    </body>
    <camera name="fixed" pos="0 -3.0 0.6612323244720535" xyaxes="1 0 0 0 0 1" />
    <camera name="track" mode="trackcom" pos="0 -3.0 0.6612323244720535" xyaxes="1 0 0 0 0 1" />
    <body name="root" pos="0 0 0" quat="1 0 0 0">
      <site name="imu" size="0.01" pos="0 0 0" />
      <geom type="mesh" rgba="1 1 1 1" mesh="base_link" contype="1" conaffinity="0" density="0" group="1" class="visualgeom" />
      <geom type="mesh" rgba="1 1 1 0" mesh="base_link" group="3" />
      <body name="Arm1_Link" pos="0 0 0.0895">
        <inertial pos="5.85026e-05 8.08931e-07 0.0151588" quat="9.54251e-06 0.707107 -1.20655e-05 0.707107" mass="0.0190944" diaginertia="4.26796e-06 3.23898e-06 2.63e-06" />
        <joint name="Arm1_Joint" range="-1.5708 1.5708" actuatorfrcrange="-100 100" />
        <geom type="mesh" rgba="1 1 1 1" mesh="Arm1_Link" contype="1" conaffinity="0" density="0" group="1" class="visualgeom" />
        <geom type="mesh" rgba="1 1 1 0" mesh="Arm1_Link" group="3" />
        <body name="Arm2_Link" pos="0 0 0.033">
          <inertial pos="0.000130416 -0.00344479 0.0308784" quat="0.707646 0.00433241 0.00588337 0.70653" mass="0.0490166" diaginertia="1.752e-05 1.39175e-05 7.83531e-06" />
          <joint name="Arm2_Joint" range="-1.5708 1.5708" actuatorfrcrange="-100 100" axis="1 0 0" />
          <geom type="mesh" rgba="1 1 1 1" mesh="Arm2_Link" contype="1" conaffinity="0" density="0" group="1" class="visualgeom" />
